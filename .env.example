# --- Required ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
ANTHROPIC_API_KEY=sk-ant-...

# --- Product ---
# Shown in the bot's greeting and /about.
PRODUCT_NAME=Мой Путь

# Language for a user who has not chosen one yet: ru | en.
# moyput.com is Russian-only; the English strings stay in the code for a future
# English-domain deployment. Users can still switch with /lang.
DEFAULT_LANG=ru

# --- Models ---
# Diagnosis (the "one thing to fix" verdict) — quality matters most here.
MODEL_DIAGNOSIS=claude-opus-5
EFFORT_DIAGNOSIS=high
# Interview follow-up questions — cheap and frequent.
MODEL_PROBE=claude-opus-5
EFFORT_PROBE=low

# --- Interview shape ---
# Adaptive follow-up questions asked after the 5-domain pulse.
MIN_PROBE_QUESTIONS=3
MAX_PROBE_QUESTIONS=6

# --- Speech to text ---
# local  = faster-whisper running in-process (no third-party API, default)
# openai = OpenAI Whisper API (requires OPENAI_API_KEY)
# none   = voice notes rejected with a friendly message
STT_BACKEND=local
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# OPENAI_API_KEY=sk-...

# --- Storage ---
DATABASE_PATH=data/myway.db

# --- Ops ---
LOG_LEVEL=INFO
# Comma-separated Telegram user IDs allowed to use the bot. Empty = open to all.
ALLOWLIST=
