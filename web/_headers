# Cloudflare Pages reads this file and applies the headers on deploy.
# The page is fully self-contained — no external scripts, fonts, or images —
# so the CSP can be strict. 'unsafe-inline' covers the inline <style> and the
# language-toggle <script>; move both to files if you want it tighter still.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
