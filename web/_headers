# Cloudflare Pages reads this file and applies the headers on deploy.
# The page is fully self-contained and ships no JavaScript at all, so scripts are
# denied outright. 'unsafe-inline' is needed only for the inline <style>; move the
# CSS to its own file if you want to drop that too.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
